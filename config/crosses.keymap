#include <input/processors/zmk-input-processor-keybind.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    text_nav: text_nav {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings =
            <&kp LC(RIGHT_ARROW)>,
            <&kp LC(LEFT_ARROW)>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;

        tick = <90>;
        wait-ms = <0>;
        tap-ms = <10>;
    };

    app_nav: app_nav {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings = <&kp TAB>, <&kp LS(TAB)>, <&none>, <&none>;

        tick = <90>;
        wait-ms = <0>;
        tap-ms = <10>;
    };

    context_nav: context_nav {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings = <&kp LC(PAGE_DOWN)>, <&kp LC(PAGE_UP)>, <&none>, <&none>;

        tick = <90>;
        wait-ms = <0>;
        tap-ms = <10>;
    };

    volume_nav: volume_nav {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings = <&none>, <&none>, <&kp C_VOL_DN>, <&kp C_VOL_UP>;

        tick = <45>;
        wait-ms = <0>;
        tap-ms = <5>;
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        Tap_Pref_200: Tap_Pref_200 {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREF_200";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        Tap_Pref_275: Tap_Pref_275 {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREF_275";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <275>;
        };

        app_hold: app_hold {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    combos {
        compatible = "zmk,combos";

        underscore {
            bindings = <&kp MINUS>;
            key-positions = <26 27>;
        };

        colon {
            bindings = <&kp SEMICOLON>;
            key-positions = <27 28>;
        };

        slash {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <28 29>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q                       &kp W                     &kp E                     &kp R                  &lt 6 T    &kp Y      &kp U                          &kp I                      &kp O                      &kp P
&Tap_Pref_200 LEFT_SHIFT A  &Tap_Pref_200 LEFT_WIN S  &Tap_Pref_275 LEFT_ALT D  &Tap_Pref_200 LCTRL F  &lt 7 G    &kp H      &Tap_Pref_200 RIGHT_CONTROL J  &Tap_Pref_275 RIGHT_ALT K  &Tap_Pref_200 RIGHT_WIN L  &Tap_Pref_200 RIGHT_SHIFT SQT
&kp Z                       &kp X                     &kp C                     &kp V                  &lt 1 B    &kp N      &kp M                          &kp COMMA                  &kp DOT                    &kp FSLH
                                                      &kp TILDE                 &lt 2 SPACE            &lt 3 TAB  &lt 5 RET  &lt 4 BACKSPACE                &kp DEL
            >;
        };

        Mouse_Layer {
            display-name = "Lower";
            bindings = <
&none   &none   &none   &none   &none  &kp BACKSPACE  &mkp MB4         &mkp MB4           &kp LS(LG(S))  &kp RS(LG(T))
&trans  &trans  &trans  &trans  &none  &kp RET        &mkp LCLK        &mkp RCLK          &mkp MCLK      &none
&none   &none   &none   &none   &none  &kp RC(X)      &kp RC(C)        &kp RC(V)          &none          &kp LS(LC(A))
                &none   &none   &none  &kp RIGHT_ALT  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL
            >;
        };

        Nav_Layer {
            display-name = "Raise";
            bindings = <
&none   &none   &kp LC(Z)  &kp LC(Y)  &kp ESC             &kp PG_UP      &kp HOME        &kp UP_ARROW  &kp END          &trans
&trans  &trans  &trans     &trans     &kp K_CONTEXT_MENU  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &trans
&none   &none   &none      &none      &kp LG(V)           &trans         &trans          &trans        &trans           &trans
                &trans     &trans     &trans              &kp RET        &kp BACKSPACE   &kp DEL
            >;
        };

        Num_Layer {
            display-name = "Mouse";
            bindings = <
&none  &none  &none  &none  &none  &kp EQUAL  &kp N7  &kp N8   &kp N9  &kp MINUS
&none  &none  &none  &none  &none  &kp MINUS  &kp N4  &kp N5   &kp N6  &kp FSLH
&none  &none  &none  &none  &none  &kp PLUS   &kp N1  &kp N2   &kp N3  &kp STAR
              &none  &none  &none  &kp RET    &kp N0  &kp DOT
            >;
        };

        Bracket_Layer {
            display-name = "Mouse";
            bindings = <
&none  &none  &kp LPAR  &kp RPAR  &kp GRAVE  &none  &none  &none  &none  &none
&none  &none  &kp LBKT  &kp RBKT  &kp PIPE   &none  &none  &none  &none  &none
&none  &none  &kp LT    &kp GT    &kp CARET  &none  &none  &none  &none  &none
              &none     &none     &none      &none  &none  &none
            >;
        };

        Func_BT_Layer {
            display-name = "FuncBT";
            bindings = <
&kp F9  &kp F10  &kp F11           &kp F12         &trans        &out OUT_TOG  &trans        &trans        &trans        &bt BT_CLR
&kp F5  &kp F6   &kp F7            &kp F8          &trans        &bt BT_PRV    &bt BT_NXT    &trans        &trans        &trans
&kp F1  &kp F2   &kp F3            &kp F4          &trans        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 4  &trans
                 &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_ALT  &trans        &trans        &trans
            >;
        };

        app_nav_layer {
            display-name = "AppNav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        context_nav_layer {
            display-name = "ContextNav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

&trackball_peripheral_listener {
    input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 2>;

    volume_navigation {
        layers = <4>;
        input-processors = <&volume_nav>;
    };
};

&trackball_central_listener {
    input-processors = <&zip_temp_layer 1 400>, <&zip_ble_report_rate_limit>;

    text_navigation {
        layers = <2>;
        input-processors = <&text_nav>;
    };

    app_navigation {
        layers = <5>;
        input-processors = <&app_nav>;
    };

    context_navigation {
        layers = <6>;
        input-processors = <&context_nav>;
    };
};
