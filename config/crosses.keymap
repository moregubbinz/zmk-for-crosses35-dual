#include <input/processors/zmk-input-processor-keybind.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    text_nav: text_nav {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;

        bindings =
            <&kp LC(RIGHT_ARROW)>,
            <&kp LC(LEFT_ARROW)>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;

        tick = <40>;
        wait-ms = <0>;
        tap-ms = <10>;
    };

    app_nav: app_nav {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;

        bindings =
            <&kp TAB>,
            <&kp LS(TAB)>,
            <&none>,
            <&none>;

        tick = <40>;
        wait-ms = <0>;
        tap-ms = <10>;
    };

    context_nav: context_nav {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;

        bindings =
            <&kp LC(PAGE_DOWN)>,
            <&kp LC(PAGE_UP)>,
            <&none>,
            <&none>;

        tick = <40>;
        wait-ms = <0>;
        tap-ms = <10>;
    };

    volume_nav: volume_nav {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;

        bindings =
            <&none>,
            <&none>,
            <&kp C_VOL_DN>,
            <&kp C_VOL_UP>;

        tick = <40>;
        wait-ms = <0>;
        tap-ms = <5>;
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        Tap_Preferred: Tap_Preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        Tap_Hold_250: Tap_Hold_250 {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_HOLD_250";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        app_hold: app_hold {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_param_1to1>,
                <&macro_press &mo MACRO_PLACEHOLDER>,
                <&macro_press &kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release &kp LALT>,
                <&macro_param_1to1>,
                <&macro_release &mo MACRO_PLACEHOLDER>;
        };

        app_tap_hold: app_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&app_hold>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        underscore {
            bindings = <&kp MINUS>;
            key-positions = <26 27>;
        };

        colon {
            bindings = <&kp SEMICOLON>;
            key-positions = <27 28>;
        };

        slash {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <28 29>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q                        &kp W                       &kp E                        &kp R                    &app_tap_hold 5 T    &kp Y    &kp U                            &kp I                       &kp O                        &kp P
&Tap_Preferred LEFT_SHIFT A  &Tap_Preferred LEFT_WIN S  &Tap_Hold_250 LEFT_ALT D    &Tap_Preferred LCTRL F   &lt 6 G              &kp H    &Tap_Preferred RIGHT_CONTROL J   &Tap_Hold_250 RIGHT_ALT K   &Tap_Preferred RIGHT_WIN L   &Tap_Preferred RIGHT_SHIFT SQT
&lt 1 Z                      &kp X                       &kp C                        &kp V                    &kp B                &kp N    &kp M                            &kp COMMA                   &kp DOT                      &kp FSLH
                                                         &kp TILDE                    &lt 2 SPACE              &lt 3 TAB            &kp ENTER  &lt 4 BACKSPACE                  &kp DEL
            >;
        };

        Mouse_Layer {
            display-name = "Lower";
            bindings = <
&none   &none      &mkp MB4   &mkp MB5   &none          &none      &none      &none      &none   &none
&trans  &trans     &trans     &trans     &kp LS(LG(S))  &none      &trans     &trans     &trans  &trans
&none   &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LS(LG(T))  &none      &none      &none      &none   &none
                   &mkp MCLK  &mkp LCLK  &mkp RCLK      &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };

        Nav_Layer {
            display-name = "Raise";
            bindings = <
&none   &none   &kp LC(Z)  &kp LC(Y)  &kp ESC             &kp PG_UP      &kp HOME        &kp UP_ARROW  &kp END          &trans
&trans  &trans  &trans     &trans     &kp K_CONTEXT_MENU  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &trans
&none   &none   &none      &none      &kp LG(V)           &trans         &trans          &trans        &trans           &trans
                &trans     &trans     &trans              &kp RET        &kp BACKSPACE   &kp DEL
            >;
        };

        Num+_Layer {
            display-name = "Mouse";
            bindings = <
&none  &kp GRAVE  &none      &kp LPAR  &kp RPAR  &kp PLUS   &kp N7   &kp N8  &kp N9  &kp STAR
&none  &kp PIPE   &none      &kp LBKT  &kp RBKT  &kp MINUS  &kp N4   &kp N5  &kp N6  &kp FSLH
&none  &none      &kp CARET  &kp LT    &kp GT    &kp EQUAL  &kp N1   &kp N2  &kp N3  &kp MINUS
                  &none      &none     &none      &kp RET    &kp DOT  &kp N0
            >;
        };

        Func_BT_Layer {
            display-name = "FuncBT";
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12  &trans  &out OUT_TOG  &trans        &trans        &trans        &bt BT_CLR
&kp F5  &kp F6   &kp F7   &kp F8   &trans  &bt BT_PRV    &bt BT_NXT    &trans        &trans        &trans
&kp F1  &kp F2   &kp F3   &kp F4   &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 4  &trans
                 &trans    &trans    &trans  &trans        &trans        &trans
            >;
        };

        app_nav_layer {
            display-name = "AppNav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        context_nav_layer {
            display-name = "ContextNav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

&trackball_peripheral_listener {
    input-processors =
        <&zip_xy_to_scroll_mapper>,
        <&zip_scroll_scaler 1 2>;

    volume_navigation {
        layers = <4>;
        input-processors = <&volume_nav>;
    };
};

&trackball_central_listener {
    input-processors =
        <&zip_ble_report_rate_limit>;

    text_navigation {
        layers = <2>;
        input-processors = <&text_nav>;
    };

    app_navigation {
        layers = <5>;
        input-processors = <&app_nav>;
    };

    context_navigation {
        layers = <6>;
        input-processors = <&context_nav>;
    };
};
